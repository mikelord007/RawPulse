<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: pulse mark + wordmark + info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mark_tile_bg"
                android:src="@drawable/ic_mark"
                android:scaleType="center"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/app_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginStart="12dp" />

            <!-- Spacer pushes the info affordance to the far edge -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/info_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_info"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/info_button_desc" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textColor="@color/app_muted"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="2dp" />

        <!-- Instrument readout -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/readout_card_bg"
            android:layout_marginTop="24dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="14dp"
                android:src="@drawable/ic_ecg_trace"
                android:scaleType="fitXY"
                android:alpha="0.18"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/heart_rate_label"
                    android:textColor="@color/app_muted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/bpm_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dash"
                        android:textColor="@color/app_text"
                        android:textSize="76sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.03"
                        android:shadowColor="#73FF3B30"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="26"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bpm"
                        android:textColor="@color/app_muted"
                        android:textSize="15sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="14dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/app_muted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textAllCaps="true"
                    android:letterSpacing="0.14"
                    android:background="@drawable/status_pill_off"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Primary action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect"
            android:textAllCaps="true"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textSize="13sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:cornerRadius="16dp"
            android:layout_marginTop="20dp" />

        <!-- Demo toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_mode"
                    android:textColor="@color/app_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_mode_sub"
                    android:textColor="@color/app_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/demo_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Age -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age_label"
                    android:textColor="@color/app_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age_sub"
                    android:textColor="@color/app_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <EditText
                android:id="@+id/age_input"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:gravity="center"
                android:textColor="@color/app_text"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:autofillHints="" />

        </LinearLayout>

        <!-- HRV disclaimer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/disclaimer_bg"
            android:padding="14dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hrv_disclaimer_title"
                android:textColor="@color/warning"
                android:fontFamily="monospace"
                android:textAllCaps="true"
                android:letterSpacing="0.14"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hrv_disclaimer_body"
                android:textColor="#D9C98E"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/instructions_title"
            android:textColor="@color/app_text"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/instructions_body"
            android:textColor="@color/app_muted"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_affiliated"
            android:textColor="@color/app_muted"
            android:textSize="12sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
